				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/DS_REST_USGS')]",
				"[concat(variables('factoryId'), '/datasets/DS_RAW_GEOJSON')]",
				"[concat(variables('factoryId'), '/dataflows/DF_DIM_REDE')]",
				"[concat(variables('factoryId'), '/dataflows/DF_FATO_TERREMOTO')]"
			]
