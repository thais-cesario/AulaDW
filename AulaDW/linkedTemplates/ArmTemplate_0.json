			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/DF_DIM_REDE')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "DS_RAW_GEOJSON",
								"type": "DatasetReference"
							},
							"name": "source1"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "DS_SQL_DIM",
								"type": "DatasetReference"
							},
							"name": "sink1"
						}
					],
					"transformations": [
						{
							"name": "flatten1"
						},
						{
							"name": "aggregate1"
						}
					],
					"scriptLines": [
						"source(output(",
						"          bbox as double[],",
						"          features as (geometry as (coordinates as double[], type as string), id as string, properties as (alert as string, cdi as double, code as string, detail as string, dmin as double, felt as short, gap as short, ids as string, mag as double, magType as string, mmi as double, net as string, nst as short, place as string, rms as double, sig as short, sources as string, status as string, time as long, title as string, tsunami as boolean, type as string, types as string, tz as string, updated as long, url as string), type as string)[],",
						"          metadata as (api as string, count as short, generated as long, status as short, title as string, url as string),",
						"          type as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false,",
						"     documentForm: 'documentPerLine') ~> source1",
						"source1 foldDown(unroll(features, features),",
						"     mapColumn(",
						"          geometry = features.geometry,",
						"          id = features.id,",
						"          properties = features.properties,",
						"          type = features.type,",
						"          CODIGO_REDE = features.properties.net",
						"     ),",
						"     skipDuplicateMapInputs: false,",
						"     skipDuplicateMapOutputs: false) ~> flatten1",
						"flatten1 aggregate(groupBy(CODIGO_REDE),",
						"     QTD_EVENTOS = count()) ~> aggregate1",
						"aggregate1 sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          REDE_SK as integer,",
						"          CODIGO_REDE as string",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     preSQLs:['DELETE FROM dbo.FATO_TERREMOTO; DELETE FROM dbo.DIM_REDE_SISMICA;'],",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     mapColumn(",
						"          CODIGO_REDE",
						"     )) ~> sink1"
					]
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/DS_RAW_GEOJSON')]",
				"[concat(variables('factoryId'), '/datasets/DS_SQL_DIM')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/DF_FATO_TERREMOTO')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "DS_RAW_GEOJSON",
								"type": "DatasetReference"
							},
							"name": "source1"
						},
						{
							"dataset": {
								"referenceName": "DS_SQL_DIM",
								"type": "DatasetReference"
							},
							"name": "source2"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "DS_SQL_FATO",
								"type": "DatasetReference"
							},
							"name": "sink1"
						}
					],
					"transformations": [
						{
							"name": "flatten1"
						},
						{
							"name": "lookup1"
						},
						{
							"name": "derivedColumn1"
						}
					],
					"scriptLines": [
						"source(output(",
						"          bbox as double[],",
						"          features as (geometry as (coordinates as double[], type as string), id as string, properties as (alert as string, cdi as double, code as string, detail as string, dmin as double, felt as short, gap as short, ids as string, mag as double, magType as string, mmi as double, net as string, nst as short, place as string, rms as double, sig as short, sources as string, status as string, time as long, title as string, tsunami as boolean, type as string, types as string, tz as string, updated as long, url as string), type as string)[],",
						"          metadata as (api as string, count as short, generated as long, status as short, title as string, url as string),",
						"          type as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false,",
						"     documentForm: 'documentPerLine') ~> source1",
						"source(output(",
						"          REDE_SK as integer,",
						"          CODIGO_REDE as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> source2",
						"source1 foldDown(unroll(features, features),",
						"     mapColumn(",
						"          coordinates = features.geometry,",
						"          id = features.id,",
						"          mag = features.properties.mag,",
						"          place = features.properties.place,",
						"          time = features.properties.time,",
						"          net = features.properties.net",
						"     ),",
						"     skipDuplicateMapInputs: false,",
						"     skipDuplicateMapOutputs: false) ~> flatten1",
						"flatten1, source2 lookup(net == CODIGO_REDE,",
						"     multiple: false,",
						"     pickup: 'any',",
						"     broadcast: 'auto')~> lookup1",
						"lookup1 derive(DATA_HORA_UTC = toTimestamp(toLong(time)),",
						"          LONGITUDE = toDecimal(coordinates.coordinates[1], 10, 6),",
						"          LATITUDE = toDecimal(coordinates.coordinates[2], 10, 6),",
						"          PROFUNDIDADE_KM = toDecimal(coordinates.coordinates[3], 10, 3)) ~> derivedColumn1",
						"derivedColumn1 sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          EVENTO_SK as long,",
						"          EVENTO_ID as string,",
						"          REDE_SK as integer,",
						"          DATA_HORA_UTC as timestamp,",
						"          MAGNITUDE as decimal(6,2),",
						"          PROFUNDIDADE_KM as decimal(10,3),",
						"          LONGITUDE as decimal(10,6),",
						"          LATITUDE as decimal(10,6),",
						"          LOCAL_DESCRICAO as string",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     mapColumn(",
						"          EVENTO_ID = id,",
						"          REDE_SK,",
						"          DATA_HORA_UTC,",
						"          MAGNITUDE = mag,",
						"          PROFUNDIDADE_KM,",
						"          LONGITUDE,",
						"          LATITUDE,",
						"          LOCAL_DESCRICAO = place",
						"     )) ~> sink1"
					]
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/DS_RAW_GEOJSON')]",
				"[concat(variables('factoryId'), '/datasets/DS_SQL_DIM')]",
				"[concat(variables('factoryId'), '/datasets/DS_SQL_FATO')]"
			]
		},
