				"typeProperties": {
					"relativeUrl": "fdsnws/event/1/query?format=geojson&starttime=2024-01-01&endtime=2024-02-01&minmagnitude=4.5&orderby=time-asc"
				},
				"schema": []
			},
			"dependsOn": [
