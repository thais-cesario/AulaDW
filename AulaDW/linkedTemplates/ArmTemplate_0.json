					"referenceName": "LS_SQL",
					"type": "LinkedServiceReference"
				},
				"annotations": [],
				"type": "SqlServerTable",
				"schema": [
					{
						"name": "EVENTO_SK",
						"type": "bigint",
						"precision": 19
					},
					{
						"name": "EVENTO_ID",
						"type": "nvarchar"
					},
					{
						"name": "REDE_SK",
						"type": "int",
						"precision": 10
					},
					{
						"name": "DATA_HORA_UTC",
						"type": "datetime2",
						"scale": 3
					},
					{
						"name": "MAGNITUDE",
						"type": "decimal",
						"precision": 6,
						"scale": 2
					},
					{
						"name": "PROFUNDIDADE_KM",
						"type": "decimal",
						"precision": 10,
						"scale": 3
					},
					{
						"name": "LONGITUDE",
						"type": "decimal",
						"precision": 10,
						"scale": 6
					},
					{
						"name": "LATITUDE",
						"type": "decimal",
						"precision": 10,
						"scale": 6
					},
					{
						"name": "LOCAL_DESCRICAO",
						"type": "nvarchar"
					}
				],
